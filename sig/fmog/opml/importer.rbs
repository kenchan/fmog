module Fmog
  module Opml
    def self.import: (String path) -> Importer::Result

    class Importer
      class Result
        attr_reader added: Integer
        attr_reader skipped: Integer
        attr_reader errors: Array[{ url: String, message: String }]

        def initialize: (added: Integer, skipped: Integer, errors: Array[{ url: String, message: String }]) -> void
      end

      def initialize: (String path) -> void
      def call: () -> Result

      private

      def collect_urls: (REXML::Element?) -> Array[String]
    end
  end
end
